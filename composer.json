{
    "name": "pulse-app/pulse-laravel",
    "description": "Surveillance Pulse pour Laravel : signal de vie, base de données, Redis, files et tâches planifiées détectés tout seuls.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://pulse-app.si",
    "keywords": [
        "laravel",
        "monitoring",
        "pulse",
        "healthcheck"
    ],
    "require": {
        "php": ">=8.1",
        "pulse-app/pulse-php": "^0.0.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pulse\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pulse\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pulse\\Laravel\\PulseServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
